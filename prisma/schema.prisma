generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserPreference {
  userId             String   @id @map("user_id")
  notificationChannel String   @default("in_app") @map("notification_channel")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  actorId    String   @map("actor_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    String   @default("{}")
  sessionId  String   @default("") @map("session_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

model Subscription {
  userId       String   @map("user_id")
  contractSlug String   @map("contract_slug")
  channel      String   @default("in_app")
  createdAt    DateTime @default(now()) @map("created_at")

  @@id([userId, contractSlug])
  @@index([userId])
  @@index([contractSlug])
  @@map("subscriptions")
}

model Notification {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id")
  contractSlug String   @map("contract_slug")
  type         String   @default("info")
  title        String
  message      String   @default("")
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique

  policies AccessPolicy[]

  @@map("permissions")
}

model Group {
  id    Int    @id @default(autoincrement())
  name  String @unique

  members     UserGroup[]
  policies    AccessPolicy[]

  @@map("groups")
}

model UserGroup {
  userId  String @map("user_id")
  groupId Int    @map("group_id")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_group")
}

model AccessRequest {
  id                  Int      @id @default(autoincrement())
  userId              String   @map("user_id")
  domain              String   @default("")
  context             String   @default("")
  dataContract        String   @default("") @map("data_contract")
  requestedPermission String   @default("reader") @map("requested_permission")
  message             String   @default("")
  status              String   @default("pending")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([userId])
  @@index([requestedPermission])
  @@map("access_requests")
}

model AccessPolicy {
  id                Int      @id @default(autoincrement())
  userId            String?  @map("user_id")
  groupId           Int?     @map("group_id")
  permissionId      Int      @map("permission_id")
  domainScope       String?  @map("domain_scope")
  contextScope      String?  @map("context_scope")
  dataContractScope String?  @map("data_contract_scope")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  group      Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@index([permissionId])
  @@index([domainScope])
  @@index([contextScope])
  @@index([dataContractScope])
  @@index([domainScope, contextScope, dataContractScope, permissionId])
  @@map("access_policies")
}
