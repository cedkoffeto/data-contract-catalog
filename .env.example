# Database — Docker Compose
PG_USER=user
PG_PASSWORD=password
PG_DB=data_contract_catalog

# pgAdmin — Docker Compose
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Keycloak — Docker Compose
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin

# Data Catalog App
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-secure-random-64-char-hex-string
AUTH_KEYCLOAK_ID=data-contract-hub
AUTH_KEYCLOAK_SECRET=CHANGE_ME_IN_PRODUCTION
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/data-contracts

DATABASE_URL="postgresql://user:password@localhost:5433/data_contract_catalog?schema=public"

# GitLab (optional — fallback to local filesystem if not set)
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_PROJECT_ID=my-group/data-contracts
GITLAB_REPOSITORY_URL=https://gitlab.example.com/my-group/data-contracts
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
